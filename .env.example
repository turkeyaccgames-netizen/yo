# این فایل نمونه است. یک کپی از آن بگیرید و اسم کپی را بگذارید .env
# بعد مقدارها را جلوی هر خط بنویسید. این فایل فقط برای اجرا روی کامپیوتر خودتان لازم است.

# توکنی که ربات BotFather به شما داده
TELEGRAM_BOT_TOKEN=

# شماره‌ی چت شما. یک عدد است. با دستور زیر پیدایش کنید:
# python main.py --chat-id
TELEGRAM_CHAT_ID=

# اختیاری: کلید رایگان گوگل برای ترند کل یوتیوب
YOUTUBE_API_KEY=

# اختیاری: کلید Claude برای انتخاب هوشمند ترکیب‌ها و متن فارسی. از console.anthropic.com بگیرید.
# از ایران فقط با VPN جواب می‌دهد. بدون این کلید ربات با روش کلمه‌ای کار می‌کند.
ANTHROPIC_API_KEY=

# اختیاری: کوکی sessionid یک اکانت اینستاگرام (بهتر است اکانت فرعی باشد، نه اکانت اصلی خودتان).
# بدون آن اینستاگرام بیشتر وقت‌ها جواب نمی‌دهد. راهنمای گرفتنش در README است.
INSTAGRAM_SESSIONID=
